# Copy to `.env` (or export these in your process manager) for production.
# Never commit the real .env.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Must be False in production.
DJANGO_DEBUG=False

# Comma-separated hostnames/IPs that may serve this app.
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Comma-separated https origins for CSRF (Django 4 requires scheme).
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Set to False only if TLS is terminated in a way that makes an app-level
# redirect loop; normally leave it True.
DJANGO_SECURE_SSL_REDIRECT=True
